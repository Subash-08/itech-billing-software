# Copy to .env.local. Never commit real credentials.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/itech_dev?appName=billing_software
MONGODB_DB=itech_dev
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
# Absolute private persistent folder outside the application.
PRIVATE_STORAGE_ROOT=/var/lib/itech-private
